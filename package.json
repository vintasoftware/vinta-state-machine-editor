{
  "name": "vinta-state-machine-editor",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Component to create, edit and visualize state machines on a pan/zoom canvas, with ordered side effects and JSON parameters.",
  "keywords": [
    "web-component",
    "custom-element",
    "state-machine",
    "editor",
    "canvas",
    "typescript"
  ],
  "license": "MIT",
  "author": "Vinta Software",
  "homepage": "https://github.com/vintasoftware/vinta-state-machine-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vinta-state-machine-editor.git"
  },
  "bugs": {
    "url": "https://github.com/vintasoftware/vinta-state-machine-editor/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/register.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host 0.0.0.0",
    "demo:build": "vite build",
    "demo:serve": "node scripts/serve-demo.ts",
    "demo": "npm run demo:build && npm run demo:serve",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{ts,js,json,jsonc,css,html,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "publishConfig": {
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
